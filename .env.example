# Kopiere diese Datei nach ".env" und trage deine Schlüssel ein.

# Für den Chat (Claude erzeugt daraus die Karten-Analysen). https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Für das Stylisieren (Nano Banana / Gemini über OpenRouter). https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Bildmodell: Standard ist Nano Banana. Andere Bildmodelle mit ihrer OpenRouter-ID eintragen (https://openrouter.ai/models).
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Optional: eigene Dienste (z. B. selbst gehostetes Valhalla/Overpass) und Port
# VALHALLA_URL=https://valhalla1.openstreetmap.de
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# NOMINATIM_URL=https://nominatim.openstreetmap.org
# PORT=3000
